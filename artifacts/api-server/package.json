    "@opentelemetry/semantic-conventions": "1.43.0",
    "@react-email/components": "^0.5.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/auth-shared": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/osce-core": "workspace:*",
    "better-auth": "^1.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "catalog:",
